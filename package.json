{
  "name": "gestion",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend && npm run test -w frontend",
    "lint": "eslint frontend/src backend/src",
    "start": "npm run start -w backend",
    "test:e2e": "node frontend/tests/smoke.mjs",
    "test:frontend": "npm run test -w frontend",
    "test:states": "node frontend/tests/pageStates.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^22.19.15",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
